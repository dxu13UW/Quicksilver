# Keep LF in the repo and in working copies on every OS, so Windows and
# Linux checkouts are byte-identical (mix format, tests and diffs agree).
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch.
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
